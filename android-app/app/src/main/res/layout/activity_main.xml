<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DOCUMENT DECODER"
            android:textColor="#5265D8"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Understand the fine print."
            android:textColor="#20243A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Turn lengthy documents into clear actions, deadlines, and requirements."
            android:textColor="#686D80"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DOCUMENT TITLE (OPTIONAL)"
            android:textColor="#42475B"
            android:textStyle="bold"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/documentTitleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:hint="e.g. Application Policy"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:textColor="#20243A"
            android:textColorHint="#969AAA" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADD YOUR DOCUMENT"
            android:textColor="#42475B"
            android:textStyle="bold"
            android:textSize="12sp" />

        <Button
            android:id="@+id/uploadPdfButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choose PDF Document"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Or paste the document text below"
            android:textColor="#686D80"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/documentTextInput"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:gravity="top|start"
            android:hint="Paste your document text here..."
            android:inputType="textMultiLine|textCapSentences"
            android:padding="14dp"
            android:scrollbars="vertical"
            android:textColor="#20243A"
            android:textColorHint="#969AAA" />

        <TextView
            android:id="@+id/characterCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:text="0 / 20000 characters"
            android:textColor="#85899A"
            android:textSize="12sp" />

        <Button
            android:id="@+id/analyzeButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:text="Analyze Document"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/historyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="View Analysis History"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/testNotificationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Test Notification" />

        <ProgressBar
            android:id="@+id/loadingIndicator"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#42475B"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="Always verify important requirements against the original document."
            android:textColor="#85899A"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
